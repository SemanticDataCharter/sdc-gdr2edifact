  "@id": "sdc4:dm-fgtbf38cj0bwxppxn69etcci",
  "identifier": "fgtbf38cj0bwxppxn69etcci",
  "label": "Remittance Advice",
  "description": "A remittance advice as a governed record: the document header with the totals debited, credited and paid and the payer's references, the invoice paid and the credit note taken into account as billing references, any other document, the accounting parties and the payee, the payment means, the tax total, and the lines, each the balance of one invoice less its credit note; with its provenance, audit event and the Business Document Audit, and the order workflow bound. The concepts are the OASIS Universal Business Language 2.3 common library, composed on the Default and ProvGov libraries. A conformant UBL RemittanceAdvice is a projection of this record.",
  "metadata": {
    "dc:title": "Remittance Advice",
    "dc:creator": "Timothy Cook",
    "dc:subject": "remittance advice; payment; business document; supply chain",
    "dc:description": "A remittance advice as a governed record: the document header with the totals debited, credited and paid and the payer's references, the invoice paid and the credit note taken into account as billing references, any other document, the accounting parties and the payee, the payment means, the tax total, and the lines, each the balance of one invoice less its credit note; with its provenance, audit event and the Business Document Audit, and the order workflow bound. The concepts are the OASIS Universal Business Language 2.3 common library, composed on the Default and ProvGov libraries. A conformant UBL RemittanceAdvice is a projection of this record.",
    "dc:rights": "CC-BY http://creativecommons.org/licenses/by/3.0/",
    "dc:language": "en-US",
    "dc:format": "text/xml",
    "dc:date": "2026-10-01T13:14:00.253642+00:00"
